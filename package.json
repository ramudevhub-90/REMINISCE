{
  "name": "reminisce",
  "version": "0.1.0",
  "private": true,
  "description": "A reminiscence companion for dementia carers, powered by Qloo's taste graph.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "vite --config web/vite.config.js",
    "build": "vite build --config web/vite.config.js",
    "layer": "npm install --prefix amplify/layers/qloo-harness/nodejs --omit=dev --no-audit --no-fund",
    "deploy:backend": "npm run layer && AWS_REGION=us-east-1 ampx deploy --identifier demo --backend --outputs-out-dir web/src --profile default -y",
    "deploy:frontend": "AWS_REGION=us-east-1 ampx deploy --identifier demo --frontend --profile default -y",
    "test": "node --import tsx --test \"amplify/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p amplify"
  },
  "dependencies": {
    "@aws-amplify/ui-react": "^6.15.7",
    "aws-amplify": "^6.22.2"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.25.1",
    "@aws-amplify/backend-cli": "^1.10.0",
    "@aws-amplify/hosting": "^1.0.1",
    "@aws-sdk/client-dynamodb": "^3.1156.0",
    "@aws-sdk/client-sesv2": "^3.1156.0",
    "@aws-sdk/client-sqs": "^3.1156.0",
    "@aws-sdk/client-ssm": "^3.1156.0",
    "@aws-sdk/client-sts": "^3.1156.0",
    "@aws-sdk/lib-dynamodb": "^3.1156.0",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-react": "^5.0.0",
    "aws-cdk-lib": "^2.274.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.0.0"
  }
}
