{
  "name": "reminisce",
  "version": "0.1.0",
  "private": true,
  "description": "A reminiscence companion for dementia carers, powered by Qloo's taste graph.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "vite --config web/vite.config.js",
    "build": "vite build --config web/vite.config.js",
    "layer": "npm install --prefix infra/layers/qloo-harness/nodejs --omit=dev --no-audit --no-fund",
    "deploy": "npm run layer && npm run build && cdk deploy reminisce",
    "config": "node scripts/config.mjs",
    "test": "node --import tsx --test \"infra/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p infra"
  },
  "dependencies": {
    "aws-amplify": "^6.22.2"
  },
  "devDependencies": {
    "@aws-appsync/utils": "^2.1.1",
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/client-dynamodb": "^3.1156.0",
    "@aws-sdk/client-sesv2": "^3.1156.0",
    "@aws-sdk/client-sqs": "^3.1156.0",
    "@aws-sdk/client-ssm": "^3.1156.0",
    "@aws-sdk/client-sts": "^3.1156.0",
    "@aws-sdk/credential-provider-node": "^3.972.90",
    "@aws-sdk/lib-dynamodb": "^3.1156.0",
    "@smithy/protocol-http": "^5.6.2",
    "@smithy/signature-v4": "^5.7.4",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-react": "^5.0.0",
    "aws-cdk": "^2.1146.1",
    "aws-cdk-lib": "^2.274.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.0.0"
  }
}
